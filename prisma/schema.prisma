generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EngineTemperature {
  id          Int      @id @default(autoincrement())
  temperature Float
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ENGINE_TEMPERATURES")
}